{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "cc_crm.main:app", "--app-dir", "backend/src", "--host", "127.0.0.1", "--port", "8000", "--reload", "--reload-dir", "backend/src"],
      "port": 8000
