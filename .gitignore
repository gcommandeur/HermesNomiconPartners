# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Env files
.env
.env.*
frontend/.env.local
backend/.env

# Local databases (inkl. Backups/Journal-Varianten wie *.db.bak, *.db.bak2,
# *.db-journal, *.db-journal.stale_move_away, *.db-wal, *.db-shm - "*.db"
# allein schliesst nur die exakte Endung aus, nicht Dateien, die "*.db" nur
# als Praefix im Namen tragen).
*.db
*.db.*
*.db-*
*.sqlite
*.sqlite3

# Echte Kandidaten-/Kanzlei-Dateien (CVs, Verträge, Notizen) - personenbezogene
# Daten, gehören nicht ins Git-Repo.
backend/data/documents/
backend/data/imports/

# Arbeitsdateien mit echten Kandidaten-/Kanzlei-Daten aus Backfill-/Review-
# Skripten (z.B. job_title_backfill_review.csv, aus der Historie entfernt am
# 2026-07-20) - jede *_review.csv im scripts-Ordner ist personenbezogen und
# gehört nicht ins Repo.
backend/scripts/*_review.csv
backend/scripts/*.csv
backend/scripts/data/
backend/scripts/*_s3_keys.txt
# Checkpoint/Resume-Datei von backfill_cv_rollen_und_schwerpunkte.py -
# enthaelt das komplette LLM-Extraktionsergebnis (Name/Rolle/Arbeitgeber/
# Historie) pro Kandidat, personenbezogen wie die *_review.csv oben.
backend/scripts/backfill_progress_*.json

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/
_cleanup_backup_legacy/

# Rollback-Artefakte von Vorfall-Korrektur-Skripten (z.B.
# scripts/fix_calendar_incident_times_20260916.py) - enthalten
# Kandidaten-/Kalenderdaten, gehoeren nie ins Repo.
backend/backups/

.claude/settings.local.json

# DigitalOcean App-Spec-Exports (doctl apps spec get) - enthalten
# EV[...]-verschluesselte Secret-Referenzen, sollen trotzdem nie versehentlich
# eingecheckt werden (Auftrag "doctl einrichten", 2026-09-16).
app-spec*.yaml
